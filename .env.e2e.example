# E2E environment for the frontend Playwright suite (vocab-management-fe-2).
# Copy to .env.e2e and fill in. .env.e2e is gitignored.
# Isolated from dev: own port, own database, own Redis db, local Supabase.
NODE_ENV=development
API_PORT=3100
API_PREFIX=/api/v1
API_CORS_ORIGINS=
APP_URL=http://localhost:3101
FRONTEND_URL=http://localhost:3101
PASSENGERS_ALLOWED=yes

# Required by the Joi schema, unused in E2E
SWAGGER_ENABLE=0
SWAGGER_PREFIX=/docs
SWAGGER_USER=e2e
SWAGGER_PASSWORD=e2e
HEALTH_TOKEN=

SENTRY_ENABLED=false

# Same Postgres container as dev (localhost:5433), separate database
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/vocab_e2e
# Redis db index 1 (dev uses 0)
REDIS_URL=redis://localhost:6379/1

# Local Supabase: run `supabase start`, then `supabase status -o env`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Copy from your dev .env (not needed by E2E flows, but validated at boot)
JWT_SECRET=<copy from .env>
JWT_ISSUER=<copy from .env>
FCM_PROJECT_ID=<copy from .env>
FCM_CLIENT_EMAIL=<copy from .env>
FCM_PRIVATE_KEY=<copy from .env>
CLOUDINARY_URL=<copy from .env>
RESEND_API_KEY=<copy from .env>

# Keep background workers off
VOCAB_EMBEDDING_ENABLED=false
REMINDER_POLLER_ENABLED=false
REMINDER_RECONCILIATION_ENABLED=false

# AI keys, Qdrant, CDC: leave unset. Vocab creates must fill textTarget so no AI job is queued.
