// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
  GUEST
}

enum ApiKeyScope {
  QUICK_ADD_VOCAB
}

enum NotificationType {
  VOCAB
  VOCAB_TRAINER
  VOCAB_SUBJECT
  SYSTEM
}

enum NotificationAction {
  CREATE
  UPDATE
  DELETE
  MULTI_CREATE
  MULTI_DELETE
  REMIND
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
}

enum TrainerStatus {
  PENDING
  IN_PROCESS
  COMPLETED
  CANCELLED
  FAILED
  PASSED
}

enum QuestionType {
  MULTIPLE_CHOICE
  FLIP_CARD
  FILL_IN_THE_BLANK
  FILL_IN_BLANK_CHOICE
  MATCHING
  TRUE_OR_FALSE
  SHORT_ANSWER
  TRANSLATION_AUDIO
}

/// How a trainer schedules its words. CLASSIC never touches FSRS state.
enum TrainerMode {
  CLASSIC
  FSRS
}

/// FSRS card state. Short-term learning steps are disabled, so a card is either never reviewed (NEW) or on a
/// day-based schedule (REVIEW), including right after a lapse. See docs/features/fsrs.md.
enum FsrsState {
  NEW
  REVIEW
}

/// Which side of a word is shown as the question. One card is scheduled per direction, because remembering the
/// meaning from the word and remembering the word from the meaning are different memories.
/// RANDOM is the exception: one card per word that is shown in a random direction each time. It is never combined with the other two.
enum FsrsDirection {
  SOURCE_TO_TARGET
  TARGET_TO_SOURCE
  RANDOM
}

/// FSRS review rating (ts-fsrs `Rating`). AGAIN = forgot, the rest = remembered.
enum FsrsRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ConfigScope {
  SYSTEM
  USER
}

model Plan {
  id            String   @id @default(cuid()) @map("id")
  role          UserRole @unique @map("role")
  name          String   @map("name")
  price         Decimal? @map("price") @db.Decimal(10, 2)
  priceLabel    String   @map("price_label")
  limits        Json     @map("limits")
  features      Json?    @map("features")
  stripePriceId String?  @map("stripe_price_id")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("plan")
}

model Language {
  id        String   @id @default(cuid()) @map("id")
  code      String   @unique @map("code")
  name      String   @map("name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sourceVocabs Vocab[] @relation("VocabSourceLanguage")
  targetVocabs Vocab[] @relation("VocabTargetLanguage")

  sourceLanguageFolders LanguageFolder[] @relation("SourceLanguageFolders")
  targetLanguageFolders LanguageFolder[] @relation("TargetLanguageFolders")

  @@index([name])
  @@index([code])
  @@map("language")
}

model LanguageFolder {
  id          String   @id @default(cuid()) @map("id")
  name        String   @map("name")
  folderColor String   @map("folder_color")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vocabs  Vocab[]
  apiKeys ApiKey[]

  sourceLanguageCode String   @map("source_language_code")
  sourceLanguage     Language @relation("SourceLanguageFolders", fields: [sourceLanguageCode], references: [code], onDelete: Cascade)

  targetLanguageCode String   @map("target_language_code")
  targetLanguage     Language @relation("TargetLanguageFolders", fields: [targetLanguageCode], references: [code], onDelete: Cascade)

  @@index([name])
  @@map("language_folder")
}

/// External login identity (token issuer + subject) mapped to one internal User.
/// Never matched by email; `userId` is the stable internal id.
model UserIdentity {
  id        String   @id @default(cuid()) @map("id")
  issuer    String   @map("issuer")
  subject   String   @map("subject")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("user_identity")
}

/// Single-use nonce for the user-initiated account link (ADR 0004). Bound to the User who asked for it.
model LinkNonce {
  id        String    @id @default(cuid()) @map("id")
  nonce     String    @unique @map("nonce")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("link_nonce")
}

model ApiKey {
  id         String        @id @default(cuid()) @map("id")
  name       String        @map("name")
  keyHash    String        @unique @map("key_hash")
  keyPrefix  String        @map("key_prefix")
  scopes     ApiKeyScope[] @map("scopes")
  createdAt  DateTime      @default(now()) @map("created_at")
  lastUsedAt DateTime?     @map("last_used_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  languageFolderId String?         @map("language_folder_id")
  languageFolder   LanguageFolder? @relation(fields: [languageFolderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([keyHash])
  @@map("api_key")
}

model Vocab {
  id                 String         @id @default(cuid()) @map("id")
  textSource         String         @map("text_source")
  sourceLanguageCode String         @map("source_language_code")
  sourceLanguage     Language       @relation("VocabSourceLanguage", fields: [sourceLanguageCode], references: [code], onDelete: Cascade)
  targetLanguageCode String         @map("target_language_code")
  targetLanguage     Language       @relation("VocabTargetLanguage", fields: [targetLanguageCode], references: [code], onDelete: Cascade)
  userId             String         @map("user_id")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageFolderId   String         @map("language_folder_id")
  languageFolder     LanguageFolder @relation(fields: [languageFolderId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  vocabTrainerWords   VocabTrainerWord[]
  textTargets         TextTarget[]
  vocabMasteries      VocabMastery[]
  vocabTrainerResults VocabTrainerResult[]
  relatedWords        VocabRelatedWord[]   @relation("VocabRelatedWords")
  linkedByWords       VocabRelatedWord[]   @relation("VocabLinkedWords")
  fsrsReviewLogs      VocabFsrsReviewLog[]

  @@unique([textSource, sourceLanguageCode, targetLanguageCode, languageFolderId])
  @@index([textSource])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([sourceLanguageCode, targetLanguageCode])
  @@index([languageFolderId])
  @@map("vocab")
}

/// Embedding state for semantic search. Lives OUTSIDE the vocab table on purpose:
/// vocab and text_target are inside the CDC publication, so writing embedding
/// state onto them would emit WAL -> CDC -> mark stale -> write -> WAL, forever.
///
/// DO NOT add this table to `vocab_embedding_pub`.
///
/// Deliberately has NO foreign key to Vocab: when a vocab is deleted the state
/// row survives as a tombstone, so the worker finds orphaned Qdrant points with a
/// cheap anti-join instead of scrolling the whole collection.
model VocabEmbeddingState {
  /// Vocab.id — no FK, see above.
  vocabId String @id @map("vocab_id")

  /// Fingerprint of the source data observed at claim time:
  /// GREATEST(vocab.updated_at, MAX(text_target.updated_at)) || ':' || COUNT(text_target.id)
  /// Cheap gate: filters in SQL so a LIMIT returns rows that actually changed.
  sourceVersion String @map("source_version")

  /// sha256 of the NFC-normalized text actually sent to the embedding model.
  /// Exact gate: an edit to `grammar`/`explanation` bumps sourceVersion but not
  /// this, so no embedding API call is made.
  contentHash String? @map("content_hash")

  /// `EMBEDDING_SPEC_ID` (e.g. "gemini-embedding-001:768") observed at last
  /// successful embed. Second exact gate alongside contentHash: a row is only
  /// left un-re-embedded when BOTH the text hash AND this spec are unchanged,
  /// so bumping EMBEDDING_SPEC in code makes every row due again without
  /// touching sourceVersion. Null means "seeded but never embedded yet" or
  /// "embedded before this column existed" — either way, due.
  embeddingSpec String? @map("embedding_spec")

  /// Log only — never used to decide whether to re-embed.
  embeddedAt DateTime? @map("embedded_at")

  /// Named to match ReminderSchedule's retry fields — same concept, same names.
  /// No `maxAttempts` counterpart on purpose: a failed embed is a sync that fell
  /// behind, not a message that expired, so it must stay retryable forever. The
  /// capped exponential backoff keeps a permanently-broken row cheap instead.
  attempt       Int       @default(0) @map("attempt")
  nextAttemptAt DateTime? @map("next_attempt_at")
  lastError     String?   @map("last_error")

  /// Lease held across the (slow) embedding call, since a Postgres row lock ends
  /// at COMMIT. Expires after a timeout so a crashed worker frees its rows.
  lockedBy String?   @map("locked_by")
  lockedAt DateTime? @map("locked_at")

  // Composite, not two single-column indexes: claimDue's WHERE always filters
  // both columns together (due for retry AND not currently leased). Neither
  // column is ever queried alone anywhere in the repository.
  @@index([nextAttemptAt, lockedAt])
  @@map("vocab_embedding_state")
}

model VocabRelatedWord {
  id            String   @id @default(cuid()) @map("id")
  vocabId       String   @map("vocab_id")
  vocab         Vocab    @relation("VocabRelatedWords", fields: [vocabId], references: [id], onDelete: Cascade)
  linkedVocabId String?  @map("linked_vocab_id")
  linkedVocab   Vocab?   @relation("VocabLinkedWords", fields: [linkedVocabId], references: [id], onDelete: Cascade)
  freeText      String?  @map("free_text")
  isSynonym     Boolean  @default(false) @map("is_synonym")
  isAntonym     Boolean  @default(false) @map("is_antonym")
  isRelated     Boolean  @default(false) @map("is_related")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([vocabId])
  @@index([linkedVocabId])
  @@index([vocabId, freeText])
  @@index([vocabId, isSynonym])
  @@index([vocabId, isAntonym])
  @@index([vocabId, isRelated])
  @@map("vocab_related_word")
}

model VocabTrainer {
  id                  String        @id @default(cuid()) @map("id")
  name                String        @map("name")
  status              TrainerStatus @map("status")
  countTime           Int           @default(0) @map("count_time")
  setCountTime        Int           @default(0) @map("set_count_time")
  reminderTime        Int           @default(0) @map("reminder_time")
  reminderDisabled    Boolean       @default(false) @map("reminder_disabled")
  reminderRepeat      Int           @default(2) @map("reminder_repeat")
  reminderLastRemind  DateTime      @default(now()) @map("reminder_last_remind")
  lastExamSubmittedAt DateTime?     @map("last_exam_submitted_at") @db.Timestamptz // Last time user submitted the exam at
  questionType        QuestionType  @default(MULTIPLE_CHOICE) @map("question_type")
  questionAnswers     Json[]        @default([]) @map("question_answers")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  mode TrainerMode @default(CLASSIC) @map("mode")

  // FSRS settings (see docs/features/fsrs.md). Used only when mode = FSRS, read only via FsrsMapper.toSettings.
  // The values are copied from the user's defaults (Config) when the trainer is created and never read from Config afterwards.
  fsrsDesiredRetention Float           @default(0.9) @map("fsrs_desired_retention") // Target recall probability at review time, 0.70-0.97
  fsrsMaximumInterval  Int             @default(36500) @map("fsrs_maximum_interval") // Longest gap between reviews, in days (1-36500)
  fsrsNewPerDay        Int?            @map("fsrs_new_per_day") // Max NEW cards introduced per local day; null = unlimited
  fsrsDirections       FsrsDirection[] @default([SOURCE_TO_TARGET, TARGET_TO_SOURCE]) @map("fsrs_directions") // Directions that get a card; at least one, fixed at creation; RANDOM only on its own
  fsrsEndsAt           DateTime?       @map("fsrs_ends_at") @db.Timestamptz // End of the cycle (for example an exam date); null = no end

  vocabAssignments VocabTrainerWord[]
  results          VocabTrainerResult[]
  fsrsReviewLogs   VocabFsrsReviewLog[]

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([reminderDisabled, reminderLastRemind])
  @@index([createdAt])
  @@index([name])
  @@map("vocab_trainer")
}

model VocabTrainerWord {
  id             String       @id @default(cuid()) @map("id")
  vocabTrainerId String       @map("vocab_trainer_id")
  vocabTrainer   VocabTrainer @relation(fields: [vocabTrainerId], references: [id], onDelete: Cascade)
  vocabId        String       @map("vocab_id")
  // NoAction (not Restrict): deleting a vocab that is still in a trainer fails with a FK violation (P2003 -> 409),
  // but deleting a whole trainer/user still works. Prisma cannot express it, so the migration makes this key
  // DEFERRABLE INITIALLY DEFERRED: the check runs at commit, after every cascade (user -> vocab and user -> trainer) is done.
  vocab          Vocab        @relation(fields: [vocabId], references: [id], onDelete: NoAction)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // FSRS cards of this word in this trainer (one per direction). Removing the word from the trainer deletes them.
  fsrsCards VocabFsrsCard[]

  @@unique([vocabTrainerId, vocabId])
  @@index([vocabTrainerId])
  @@index([vocabId])
  @@index([vocabTrainerId, createdAt])
  @@index([createdAt])
  @@map("vocab_trainer_word")
}

model VocabTrainerResult {
  id             String        @id @default(cuid()) @map("id")
  vocabTrainerId String        @map("vocab_trainer_id")
  vocabTrainer   VocabTrainer  @relation(fields: [vocabTrainerId], references: [id], onDelete: Cascade)
  vocabId        String?       @map("vocab_id")
  vocab          Vocab?        @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  status         TrainerStatus @map("status")
  userSelected   String        @map("user_selected")
  systemSelected String        @map("system_selected")
  data           Json?         @map("data")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([vocabTrainerId])
  @@index([vocabTrainerId, status])
  @@index([vocabTrainerId, createdAt])
  @@index([vocabId])
  @@index([vocabId, status])
  @@index([status])
  @@index([createdAt])
  @@map("vocab_trainer_result")
}

model TextTarget {
  id                 String              @id @default(cuid()) @map("id")
  vocabId            String              @map("vocab_id")
  vocab              Vocab               @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  wordTypeId         String?             @map("word_type_id")
  wordType           WordType?           @relation(fields: [wordTypeId], references: [id], onDelete: SetNull)
  textTarget         String              @map("text_target")
  grammar            String?             @map("grammar")
  explanationSource  String?             @map("explanation_source")
  explanationTarget  String?             @map("explanation_target")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  vocabExamples      VocabExample[]
  textTargetSubjects TextTargetSubject[]

  @@unique([vocabId, textTarget])
  @@index([vocabId])
  @@index([wordTypeId])
  @@index([textTarget])
  @@index([createdAt])
  @@map("text_target")
}

model VocabExample {
  id           String     @id @default(cuid()) @map("id")
  textTargetId String     @map("text_target_id")
  textTarget   TextTarget @relation(fields: [textTargetId], references: [id], onDelete: Cascade)
  source       String     @map("source")
  target       String     @map("target")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([textTargetId])
  @@index([textTargetId, createdAt])
  @@index([source])
  @@index([target])
  @@map("vocab_example")
}

model WordType {
  id          String       @id @default(cuid()) @map("id")
  name        String       @unique @map("name")
  description String       @map("description")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  textTargets TextTarget[]

  @@index([name])
  @@map("word_type")
}

model Subject {
  id                 String              @id @default(cuid()) @map("id")
  name               String              @map("name")
  order              Int                 @map("order")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  textTargetSubjects TextTargetSubject[]
  userId             String              @map("user_id")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Functional unique index (case-insensitive per user) is managed via raw SQL migration
  @@index([order])
  @@index([userId])
  @@map("subject")
}

model TextTargetSubject {
  id           String     @id @default(cuid()) @map("id")
  textTargetId String     @map("text_target_id")
  textTarget   TextTarget @relation(fields: [textTargetId], references: [id], onDelete: Cascade)
  subjectId    String     @map("subject_id")
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([textTargetId, subjectId])
  @@index([textTargetId])
  @@index([subjectId])
  @@index([subjectId, textTargetId])
  @@map("text_target_subject")
}

model Notification {
  id                     String                  @id @default(cuid()) @map("id")
  type                   NotificationType        @map("type")
  action                 NotificationAction      @map("action")
  priority               PriorityLevel           @map("priority")
  data                   Json                    @map("data")
  isActive               Boolean                 @default(true) @map("is_active")
  expiresAt              DateTime                @map("expires_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  notificationRecipients NotificationRecipient[]

  @@index([type, isActive])
  @@index([priority, isActive])
  @@index([isActive, expiresAt])
  @@index([isActive, createdAt])
  @@index([createdAt])
  @@map("notification")
}

model NotificationRecipient {
  id             String       @id @default(cuid()) @map("id")
  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false) @map("is_read")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([notificationId, userId])
  @@index([userId, isRead, isDeleted])
  @@index([userId, isDeleted, createdAt])
  @@index([notificationId, isRead])
  @@index([userId])
  @@index([notificationId])
  @@index([isRead])
  @@index([isDeleted])
  @@map("notification_recipient")
}

model User {
  id                     String                  @id @default(cuid()) @map("id")
  email                  String                  @unique @map("email")
  firstName              String                  @map("first_name")
  lastName               String                  @map("last_name")
  phone                  String?                 @map("phone")
  avatar                 String?                 @map("avatar")
  role                   UserRole                @default(GUEST) @map("role")
  isActive               Boolean                 @default(true) @map("is_active")
  /// Per-user off-switch for the public MCP endpoint, on by default. The plan decides who may use MCP (GUEST is blocked in the MCP guard); an admin turns this off to cut one user. Checked on every MCP request (#21).
  mcpAccess              Boolean                 @default(true) @map("mcp_access")
  emailConfirmed         Boolean                 @default(false) @map("email_confirmed")
  supabaseUserId         String?                 @unique @map("supabase_user_id")
  identities             UserIdentity[]
  linkNonces             LinkNonce[]
  chatLastReadAt         DateTime?               @map("chat_last_read_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  notificationRecipients NotificationRecipient[]
  vocabs                 Vocab[]
  vocabTrainers          VocabTrainer[]
  subjects               Subject[]
  userFcmTokens          UserFcmToken[]
  languageFolders        LanguageFolder[]
  configs                Config[]
  vocabMasteries         VocabMastery[]
  reminderSchedules      ReminderSchedule[]
  chatMessages           ChatMessage[]
  apiKeys                ApiKey[]
  vocabFsrsCards         VocabFsrsCard[]
  vocabFsrsReviewLogs    VocabFsrsReviewLog[]

  @@index([role, isActive])
  @@index([isActive, createdAt])
  @@index([email, isActive])
  @@index([firstName, lastName])
  @@index([phone])
  @@map("user")
}

model UserFcmToken {
  userId     String    @map("user_id")
  fcmToken   String    @map("fcm_token")
  deviceType String?   @map("device_type")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")
  deletedBy  String?   @map("deleted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, fcmToken])
  @@index([fcmToken])
  @@map("user_fcm_token")
}

model Config {
  id        String      @id @default(cuid()) @map("id")
  scope     ConfigScope @default(SYSTEM) @map("scope")
  userId    String?     @map("user_id")
  key       String      @map("key")
  value     Json        @map("value")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, userId, key])
  @@index([key, isActive])
  @@index([scope, userId])
  @@index([userId])
  @@map("config")
}

model VocabMastery {
  id             String   @id @default(cuid()) @map("id")
  vocabId        String   @map("vocab_id")
  vocab          Vocab    @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  masteryScore   Float    @default(0) @map("mastery_score")
  correctCount   Int      @default(0) @map("correct_count")
  incorrectCount Int      @default(0) @map("incorrect_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  history VocabMasteryHistory[]

  @@unique([vocabId, userId])
  @@index([vocabId, userId])
  @@index([userId])
  @@index([userId, incorrectCount])
  @@index([userId, masteryScore])
  @@map("vocab_mastery")
}

/// FSRS scheduling state of one word, in one direction, inside one FSRS trainer (see docs/features/fsrs.md).
/// A trainer is one learning cycle: the same word in two trainers has two independent cards.
/// A row exists only while the word is in the trainer: the composite foreign key to VocabTrainerWord deletes the card
/// when the word is removed, and rejects a card for a word that is not in the trainer. Classic code never touches this table.
/// Field names follow ts-fsrs.
///
/// CHECK constraints are hand-written at the end of the add_fsrs migration because Prisma cannot declare them.
/// Re-add them if that migration is ever regenerated:
///   vocab_fsrs_card:  stability >= 0, difficulty = 0 OR difficulty BETWEEN 1 AND 10, reps >= 0, lapses >= 0, scheduled_days >= 0
///   vocab_trainer:    fsrs_desired_retention BETWEEN 0.70 AND 0.97, fsrs_maximum_interval BETWEEN 1 AND 36500,
///                     fsrs_new_per_day >= 1 (when not null), cardinality(fsrs_directions) >= 1
model VocabFsrsCard {
  id             String           @id @default(cuid()) @map("id")
  vocabTrainerId String           @map("vocab_trainer_id")
  vocabId        String           @map("vocab_id")
  trainerWord    VocabTrainerWord @relation(fields: [vocabTrainerId, vocabId], references: [vocabTrainerId, vocabId], onDelete: Cascade)
  direction      FsrsDirection    @map("direction")
  userId         String           @map("user_id") // Copied from the trainer owner, for the cross-trainer "due today" query
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  state          FsrsState        @default(NEW) @map("state") // NEW = enrolled but never reviewed
  due            DateTime         @default(now()) @map("due") @db.Timestamptz // Next review time
  stability      Float            @default(0) @map("stability") // Days until recall probability falls to the desired retention
  difficulty     Float            @default(0) @map("difficulty") // 1 (easy) to 10 (hard); 0 until the first review
  reps           Int              @default(0) @map("reps") // Total reviews
  lapses         Int              @default(0) @map("lapses") // Times forgotten after the card was learned
  scheduledDays  Int              @default(0) @map("scheduled_days") // Interval chosen at the last review, in days
  lastReviewedAt DateTime?        @map("last_reviewed_at") @db.Timestamptz // Null until the first review
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([vocabTrainerId, vocabId, direction])
  @@index([vocabTrainerId, due])
  @@index([userId, due])
  @@map("vocab_fsrs_card")
}

/// One append-only row per FSRS review of a card. Feeds stats, the heatmap and (later) parameter optimisation.
/// answerId is a client-generated idempotency key (no FK): insert the log first and treat P2002 as a duplicate request.
/// Deleted together with its trainer (one trainer = one learning cycle). vocabId is set to null when the vocab is
/// deleted, so history survives a deleted word.
/// `*After` columns hold the card state produced by this review; prevState and elapsedDays describe the state before it.
model VocabFsrsReviewLog {
  id                       String        @id @default(cuid()) @map("id")
  answerId                 String        @unique @map("answer_id")
  userId                   String        @map("user_id")
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabId                  String?       @map("vocab_id")
  vocab                    Vocab?        @relation(fields: [vocabId], references: [id], onDelete: SetNull)
  vocabTrainerId           String        @map("vocab_trainer_id")
  vocabTrainer             VocabTrainer  @relation(fields: [vocabTrainerId], references: [id], onDelete: Cascade)
  direction                FsrsDirection @map("direction")
  rating                   FsrsRating    @map("rating")
  prevState                FsrsState     @map("prev_state") // State before this review; prevState = NEW counts toward fsrsNewPerDay
  elapsedDays              Int           @map("elapsed_days") // Days since the previous review, computed from lastReviewedAt
  stateAfter               FsrsState     @map("state_after")
  dueAfter                 DateTime      @map("due_after") @db.Timestamptz // Next review time chosen by this review
  stabilityAfter           Float         @map("stability_after")
  difficultyAfter          Float         @map("difficulty_after")
  scheduledDaysAfter       Int           @map("scheduled_days_after")
  desiredRetentionAtReview Float         @map("desired_retention_at_review") // Snapshot of the trainer setting, it can change later
  durationMs               Int?          @map("duration_ms") // Time from showing the card to rating it; null if not measured
  questionType             QuestionType  @map("question_type") // FLIP_CARD or FILL_IN_THE_BLANK
  isAhead                  Boolean       @default(false) @map("is_ahead") // Reviewed before it was due
  reviewedAt               DateTime      @map("reviewed_at") @db.Timestamptz // Server time
  createdAt                DateTime      @default(now()) @map("created_at")

  @@index([userId, reviewedAt])
  @@index([vocabTrainerId, reviewedAt])
  @@index([vocabTrainerId, vocabId, direction, reviewedAt])
  @@index([vocabId])
  @@map("vocab_fsrs_review_log")
}

enum ReminderChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
  DISCORD
  ZALO
}

enum ReminderScheduleKind {
  INITIAL
  ESCALATION
}

enum ReminderScheduleStatus {
  PENDING
  CLAIMED
  QUEUED
  SENDING
  SENT
  FAILED_RETRYABLE
  FAILED_TERMINAL
  EXPIRED
  CANCELLED
}

model ReminderSchedule {
  id                String                 @id @default(cuid()) @map("id")
  dedupeKey         String                 @map("dedupe_key")
  channel           ReminderChannel        @default(EMAIL) @map("channel")
  recipient         String                 @map("recipient")
  template          String                 @map("template")
  templateVersion   Int                    @default(1) @map("template_version")
  payload           Json                   @default("{}") @map("payload")
  subject           String?                @map("subject")
  dueAt             DateTime               @map("due_at") @db.Timestamptz
  priority          Int                    @default(0) @map("priority")
  status            ReminderScheduleStatus @default(PENDING) @map("status")
  attempt           Int                    @default(0) @map("attempt")
  maxAttempts       Int                    @default(3) @map("max_attempts")
  nextAttemptAt     DateTime?              @map("next_attempt_at") @db.Timestamptz
  lockedBy          String?                @map("locked_by")
  lockedAt          DateTime?              @map("locked_at") @db.Timestamptz
  lastErrorCode     String?                @map("last_error_code")
  lastErrorMsg      String?                @map("last_error_msg") @db.Text
  errorHistory      Json                   @default("[]") @map("error_history")
  providerMsgId     String?                @map("provider_msg_id")
  reminderType      ReminderScheduleKind   @default(INITIAL) @map("reminder_type")
  escalationLevel   Int                    @default(0) @map("escalation_level")
  escalationMax     Int                    @default(3) @map("escalation_max")
  initialReminderId String?                @map("initial_reminder_id")
  initialReminder   ReminderSchedule?      @relation("EscalationChain", fields: [initialReminderId], references: [id], onDelete: SetNull)
  escalations       ReminderSchedule[]     @relation("EscalationChain")
  actedCheckAfter   DateTime?              @map("acted_check_after") @db.Timestamptz
  chainCount        Int                    @default(0) @map("chain_count")
  chainMax          Int                    @default(30) @map("chain_max")
  cancelledAt       DateTime?              @map("cancelled_at") @db.Timestamptz
  cancelledBy       String?                @map("cancelled_by")
  cancelReason      String?                @map("cancel_reason")
  sentAt            DateTime?              @map("sent_at") @db.Timestamptz
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz
  userId            String?                @map("user_id")
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType        String?                @map("entity_type")
  entityId          String?                @map("entity_id")
  metadata          Json                   @default("{}") @map("metadata")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([status, dueAt, priority(sort: Desc)])
  @@index([status, lockedAt])
  @@index([initialReminderId, escalationLevel])
  @@index([entityType, entityId, status])
  @@index([userId, status, dueAt])
  @@map("reminder_schedule")
}

model VocabMasteryHistory {
  id             String       @id @default(cuid()) @map("id")
  vocabMasteryId String       @map("vocab_mastery_id")
  vocabMastery   VocabMastery @relation(fields: [vocabMasteryId], references: [id], onDelete: Cascade)
  masteryScore   Float        @map("mastery_score")
  correctCount   Int          @map("correct_count")
  incorrectCount Int          @map("incorrect_count")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([vocabMasteryId, createdAt])
  @@index([createdAt])
  @@map("vocab_mastery_history")
}

model JobFailure {
  id           String   @id @default(cuid()) @map("id")
  queueName    String   @map("queue_name")
  jobId        String   @map("job_id")
  jobName      String   @map("job_name")
  payload      Json     @map("payload")
  error        String   @map("error")
  stackTrace   String?  @map("stack_trace")
  attemptsMade Int      @map("attempts_made")
  maxAttempts  Int      @map("max_attempts")
  failedAt     DateTime @map("failed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([queueName, jobId])
  @@index([queueName, failedAt])
  @@map("job_failure")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id         String   @id @default(cuid()) @map("id")
  userId     String   @map("user_id")
  role       ChatRole @map("role")
  message    String   @map("message") @db.Text
  toolCalls  Json?    @map("tool_calls")
  tokenCount Int?     @map("token_count")
  latencyMs  Int?     @map("latency_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Asc)])
  @@map("chat_messages")
}
