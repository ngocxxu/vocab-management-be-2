# -----------------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------------
# development | production | test | staging
NODE_ENV=development

# Port and HTTP API path (no trailing slash on prefix unless you intend it)
API_PORT=3002
API_PREFIX=/api/v1

# Comma-separated browser origins for production CORS (ignored in non-production for permissive dev CORS)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://yourdomain.com

# Public URLs (used in auth redirects and links)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000/vocab-trainer

# Legacy / domain flag used by existing validation (yes | no)
PASSENGERS_ALLOWED=yes

# -----------------------------------------------------------------------------
# Swagger
# -----------------------------------------------------------------------------
# Swagger is served only when this is exactly 1; unset or any other value keeps it off
SWAGGER_ENABLE=1
# Use a non-root prefix (e.g. /docs) so basic auth below applies to the docs
SWAGGER_PREFIX=/
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# -----------------------------------------------------------------------------
# Bull Board (queue dashboard at /admin/queues)
# -----------------------------------------------------------------------------
# Basic auth credentials. Leave either unset and the dashboard answers 404.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# -----------------------------------------------------------------------------
# Health
# -----------------------------------------------------------------------------
HEALTH_TOKEN=

# -----------------------------------------------------------------------------
# Sentry (runtime observability)
# -----------------------------------------------------------------------------
# SENTRY_ENABLED is the ONLY switch. A DSN says WHERE to send, never WHETHER.
# Must be the exact string 'true' to enable capture; anything else is off.
# Switch on with an empty DSN is a misconfiguration and warns on startup.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0 while on the free plan. Raise temporarily to investigate performance.
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DEBUG=false

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://admin:admin@localhost:5433/vocab_db?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ, throttler, cache)
# -----------------------------------------------------------------------------
# Option A: single URL (preferred when set)
REDIS_URL=redis://localhost:6379
# Option B: omit REDIS_URL and set host + port (password/db optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
REDIS_RETRY_DELAY=100
REDIS_MAX_RETRIES=3
# REDIS_ENABLE_READY_CHECK=true
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_TTL=3600

# -----------------------------------------------------------------------------
# JWT (only RestrictedGuard's HS256 role token; request authentication uses Auth0/Supabase)
# -----------------------------------------------------------------------------
JWT_SECRET=ThisMustBeChanged
JWT_ISSUER=IssuerApplication

# -----------------------------------------------------------------------------
# Auth0 (access-token validation; the backend is a resource server only)
# AUTH0_ISSUER must be the tenant domain, not a custom domain: Management API calls are built from it.
# Leave both empty to accept Supabase tokens only. AUTH0_AUDIENCE is required once
# AUTH0_ISSUER is set. Dev: https://vocab-development.jp.auth0.com/
# -----------------------------------------------------------------------------
AUTH0_ISSUER=
AUTH0_AUDIENCE=
# Client id of the Vocab web app (the `aud` of its ID tokens). Needed for connecting a second sign-in method;
# leave empty and every link request is refused with id_token_invalid.
AUTH0_CLIENT_ID=
# Database connection that password logins live on. Defaults to Username-Password-Authentication.
# Adding a password also needs create:users on the M2M client (AUTH0_M2M_*) below.
AUTH0_PASSWORD_CONNECTION=
# Prefix of the custom claims the Auth0 post-login Action adds to access tokens: <ns>email, <ns>email_verified,
# <ns>given_name, <ns>family_name, <ns>picture. Without it new users cannot be provisioned (no verified email).
AUTH0_CLAIM_NAMESPACE=
# Machine-to-machine application authorised for the Management API scope delete:users. Used only to delete the
# Auth0 account when an admin deletes a user; if unset the delete still works and the Auth0 account is left behind.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM)
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Use literal \n for newlines when storing in .env
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Media / AI (optional API keys — required only for the provider you use)
# -----------------------------------------------------------------------------
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@your_cloud_name
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OMNIROUTE_API_KEY=

# -----------------------------------------------------------------------------
# Vocab semantic search (Qdrant + Gemini embeddings)
# -----------------------------------------------------------------------------
# Not required to boot — the embedding worker just stays idle without these.
# Needed only to actually run semantic search.
QDRANT_URL=
QDRANT_API_KEY=

# Kill-switch for the background embedding worker. Leave unset to keep it on.
# VOCAB_EMBEDDING_ENABLED=false

# Shared secret for the Sequin CDC webhook (POST /internal/cdc/vocab-changed).
# Unset means that endpoint rejects every request rather than defaulting open.
# CDC is a latency optimisation only: without it the worker's periodic scan
# still picks up every change, just up to one tick later.
CDC_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Reminders / queues (optional)
# -----------------------------------------------------------------------------
# INSTANCE_ID=my-worker-1
# REMINDER_POLLER_ENABLED=false
# REMINDER_RECONCILIATION_ENABLED=false

# -----------------------------------------------------------------------------
# Resend (email service)
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare AI
# -----------------------------------------------------------------------------
CLOUDFLARE_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=